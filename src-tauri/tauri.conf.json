{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "云笔 - 智能翻页笔客户端",
  "version": "2.0.0",
  "identifier": "io.github.ant-cave",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:7548",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "云笔 - 智能翻页笔客户端",
        "width": 1152,
        "height": 648,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "wix": null
    }
  }
}
